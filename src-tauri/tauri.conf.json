{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel Forge",
  "version": "0.1.0",
  "identifier": "io.github.neshath.pixel-forge",
  "build": {
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run desktop:stage",
    "devUrl": "http://127.0.0.1:4173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pixel Forge — Retro Game Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png"
    ]
  }
}
